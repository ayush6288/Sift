SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# Newer Google AI Studio keys reject gemini-2.5-flash with a 404.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Optional: decouple webhook signing from the service-role key.
# WEBHOOK_SECRET=replace-with-a-long-random-secret
# Optional: override the exact browser origins allowed to call the API.
# FRONTEND_ORIGINS=https://my-micro-sass.vercel.app,http://localhost:5173
# Optional: rolling 24-hour per-inbox ingestion cap (default 500).
# MAX_EMAILS_PER_DAY=500
# Set to development to expose /docs, /redoc, and /openapi.json locally.
# ENV=development
